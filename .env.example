# Secrets de Griot Secure. Copier ce fichier : cp .env.example .env
# Les valeurs ci-dessous suffisent pour la DÉMO (données fictives).
# En déploiement réel : remplacer CHAQUE valeur, par exemple avec : openssl rand -hex 32
# Le fichier .env n'est jamais commité (voir .gitignore).

# Mot de passe du super-utilisateur PostgreSQL
POSTGRES_PASSWORD=demo-postgres-a-changer

# Mot de passe de la base de Keycloak
KEYCLOAK_DB_PASSWORD=demo-keycloak-db-a-changer

# Administrateur technique de Keycloak (realm « master », joignable seulement par http://keycloak:8080)
KEYCLOAK_ADMIN_PASSWORD=demo-admin-keycloak-a-changer

# Secret partagé entre Keycloak et le guichet (client OIDC « guichet »)
GUICHET_OIDC_SECRET=demo-secret-oidc-guichet-a-changer

# Secret du médiateur pour pseudonymiser les citoyens dans le journal (HMAC-SHA256)
MEDIATEUR_HMAC_SECRET=demo-secret-pseudonyme-a-changer

# Secrets partagés entre le médiateur et chaque écran usager (API usager). Un secret par écran : le médiateur
# en déduit le canal écrit au journal (ussd | web). Vide = cet écran est fermé.
CANAL_USAGER_SECRET=demo-secret-canal-usager-a-changer
CANAL_WEB_SECRET=demo-secret-canal-web-a-changer

# Comptes de TEST (banc de pannes, scripts/demande.py) : 1 = créés par scripts/outils_test.py ; 0 = supprimés.
# Mettre 0 (puis python scripts/outils_test.py) AVANT la démonstration devant le jury.
OUTILS_TEST=0
OUTILS_TEST_SECRET=demo-secret-outils-de-test-a-changer

# Données des registres : dossier monté sur /donnees. Le jour J : DONNEES_REGISTRES=./donnees_jury
DONNEES_REGISTRES=./registres/donnees_fictives

# Jeton de l'API du jury (si le jury fournit une API) : utilisé dans l'adaptateur par « {secret:api_jury} »
API_JURY_SECRET=

# Annuaire USSD (numéro de téléphone -> identifiant de l'usager, PIN). Le jour J : ./donnees_jury/abonnes.yaml
ABONNES_USSD=./espace-usager/ussd/abonnes.yaml

# API du jury EN DIRECT (profil api-jury) : adresse UNIQUE vers laquelle le relais transmet. Vide = pas d'API.
API_JURY_URL=

# Dossier des fichiers de secrets (un fichier par secret : guichet_oidc, sujet_hmac, canal_usager, canal_web, api_jury).
# Absent : socle/secrets-demo (valeurs de démonstration). En déploiement : un dossier hors du dépôt.
# GRIOT_SECRETS_DIR=./secrets_locaux
