# Caddy : point d'entrée HTTPS unique de Griot Secure.
# Les certificats sont signés par l'autorité de certification INTERNE de Caddy
# (« tls internal ») : aucun contact avec Let's Encrypt ni avec Internet.
# Le médiateur et les registres ne sont PAS publiés : ils restent sur le réseau interne.

{
	# Ne pas tenter d'installer la CA dans le magasin du conteneur (inutile ici)
	skip_install_trust
	# Pas d'API d'administration de Caddy
	admin off
}

# En-têtes de sécurité communs à tous les sites
(securite) {
	tls internal
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}

# Pages à rendu serveur : aucun script autorisé, aucune ressource externe
(sans_script) {
	header {
		X-Frame-Options "DENY"
		Cache-Control "no-store"
		Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; form-action 'self' https://auth.griot.test; frame-ancestors 'none'; base-uri 'none'"
	}
}

# Keycloak : connexion des agents (mot de passe + code TOTP)
# La console technique (/admin) et le realm « master » ne sont PAS publiés.
auth.griot.test {
	import securite
	@interdit path /admin* /realms/master*
	handle @interdit {
		respond "Introuvable" 404
	}
	handle {
		reverse_proxy keycloak:8080
	}
}

# Guichet des agents
guichet.griot.test {
	import securite
	import sans_script
	reverse_proxy guichet:8000
}

# Écrans de l'usager : l'USSD simulé (*226#) à la racine, le portail web sous /portail (conteneur séparé)
usager.griot.test {
	import securite
	import sans_script
	handle /portail* {
		reverse_proxy portail:8000
	}
	handle {
		reverse_proxy ussd_sim:8000
	}
	# Portail arrêté (docker compose stop portail) : message clair, l'USSD continue
	handle_errors 502 503 504 {
		header Content-Type "text/plain; charset=utf-8"
		handle /portail* {
			respond "Portail web arrêté. Rien n'a été transmis. Le service *226# reste disponible : https://usager.griot.test/" 503
		}
		handle {
			respond "Service momentanément indisponible. Rien n'a été transmis." 503
		}
	}
}
