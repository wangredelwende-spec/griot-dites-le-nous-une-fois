# Secrets de Griot Secure. Copier ce fichier : cp .env.example .env
# Les valeurs ci-dessous suffisent pour la DÉMO (données fictives).
# En déploiement réel : remplacer CHAQUE valeur, par exemple avec : openssl rand -hex 32
# Le fichier .env n'est jamais commité (voir .gitignore).

# Mot de passe du super-utilisateur PostgreSQL
POSTGRES_PASSWORD=demo-postgres-a-changer

# Mot de passe de la base de Keycloak
KEYCLOAK_DB_PASSWORD=demo-keycloak-db-a-changer

# Administrateur technique de Keycloak (realm « master », joignable seulement par http://keycloak:8080)
KEYCLOAK_ADMIN_PASSWORD=demo-admin-keycloak-a-changer

# Secret partagé entre Keycloak et le guichet (client OIDC « guichet »)
GUICHET_OIDC_SECRET=demo-secret-oidc-guichet-a-changer

# Secret du médiateur pour pseudonymiser les citoyens dans le journal (HMAC-SHA256)
MEDIATEUR_HMAC_SECRET=demo-secret-pseudonyme-a-changer

# Secret partagé entre le médiateur et les écrans usager (USSD simulé, portail) : API usager
CANAL_USAGER_SECRET=demo-secret-canal-usager-a-changer
