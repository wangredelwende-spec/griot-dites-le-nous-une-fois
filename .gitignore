# Secrets : ne jamais les commiter (on fournit .env.example à la place)
.env

# Données générées au démarrage (bases, clés, certificats Caddy)
donnees/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Exports et dumps produits par les scripts de vérification
*.dump
*.sql.gz
preuves/

# Éditeurs et système
.vscode/
.idea/
Thumbs.db
.DS_Store
caddy-racine.crt

# Notes de travail locales
CLAUDE.md

# Données fournies par le jury : hors du dépôt public sauf autorisation explicite
donnees_jury/

# Secrets locaux des tests de bout en bout (TOTP du compte de test, CA de Caddy)
tests/.secrets/

# Sauvegarde hors ligne des images Docker (resilience/sauvegarder_hors_ligne.py) : plusieurs centaines de Mo
hors_ligne/

# Sorties de l'OCR (scripts de conversion PDF -> CSV) : le CSV et sa provenance s'écrivent
# à côté du PDF source, à relire hors du dépôt (donnees_jury/ est déjà ignoré ci-dessus)
*.provenance.json
registres/tests/donnees_formats/etat_civil_scanne.csv

# Archives d images Docker : jamais dans le dépôt, où qu elles soient
*.tar

# Copies du catalogue gardées par remise_a_zero.py avant restauration
consentement-minimisation/catalogue/*.bak
